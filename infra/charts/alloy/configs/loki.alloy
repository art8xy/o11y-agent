loki.write "loki" {
  endpoint {
    url = "http://loki.o11y.svc.cluster.local:3100/loki/api/v1/push"
  }
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action = "replace"
    target_label = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    action = "replace"
    target_label = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "__path__"
    separator = "/"
    replacement = "/var/log/pods/*$1/*.log"
  }
}

loki.source.kubernetes "pods_logs" {
  targets    = discovery.relabel.pods_logs.output
  forward_to = [loki.process.pods_logs.receiver]
}

loki.process "pods_logs" {
  stage.static_labels {
    values = {
      cluster = "minikube",
    }
  }
  forward_to = [loki.write.loki.receiver]
}