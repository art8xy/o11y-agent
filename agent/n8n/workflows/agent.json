    {
      "parameters": {
        "promptType": "define",
        "text": "=#### Tempo Summary\n{{ $('Merge').item.json.tempo.summary\n  ? $('Merge').item.json.tempo.summary\n  : \"No summary\"\n}}\n\n#### Loki Summary\n{{ $('Merge').item.json.loki.summary\n  ? $('Merge').item.json.loki.summary\n  : \"No summary\"\n}}\n\n#### Evidence\n**Trace**\n{{ $('Tempo Report').item.json.tempo.trace\n? `\\`\\`\\`\n$${$('Tempo Report').item.json.tempo.trace}\n\\`\\`\\``\n: \"No traces found.\"\n}}\n\n**Logs**\n{{ $('Loki Report').item.json.loki.logs?.length\n? `\\`\\`\\`\n$${$('Loki Report').item.json.loki.logs.map(item => `$${item}`).join(\"\\n\")}\n\\`\\`\\``\n: \"No logs found.\"\n}}\n\n### Alert JSON\n{{ $('Parameters').item.json.alert.toJsonString() }}\n\n\n\n\n\n\n\n\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=## Overview\nYou are an Observability Agent embedded in an observability platform.  \nYour task is to analyze the findings provided by other Agents and form a diagnostic report.  \nYour goal is to help an engineer understand the incident and progress toward resolution by performing the root-cause analysis.\n\n## General Rules\n- Never contain questions or clarifications.\n- Do not speculate or infer beyond available findings.\n- Avoid vague or generic recommendations.\n- Summary and root cause statement MUST be backed by explicit evidence.\n\n## Tasks\n1. Form a reasoned hypothesis of the most likely root cause.\n2. Produce a human-readable, engineer-ready diagnostic report."
            }
          ]
        },
        "batching": {}
      },
