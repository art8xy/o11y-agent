        "jsCode": "const items = $input.all();\n\nlet promptTokens = 0;\nlet completionTokens = 0;\nlet totalTokens = 0;\n\nfor (const item of items) {\n  const runData = item.json?.data?.resultData?.runData;\n  if (!runData) continue;\n\n  for (const [nodeName, executions] of Object.entries(runData)) {\n    if (!nodeName.includes(\"Model\")) continue;\n\n    for (const execution of executions) {\n      const lmData = execution?.data?.ai_languageModel;\n      if (!Array.isArray(lmData)) continue;\n\n      for (const group of lmData) {\n        if (!Array.isArray(group)) continue;\n\n        for (const output of group) {\n          const json = output?.json;\n          if (!json) continue;\n\n          const usage = json.tokenUsage ?? json.tokenUsageEstimate;\n          if (!usage) continue;\n\n          promptTokens += usage.promptTokens ?? 0;\n          completionTokens += usage.completionTokens ?? 0;\n          totalTokens += usage.totalTokens ?? 0;\n        }\n      }\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      loki: {\n        promptTokens: promptTokens,\n        completionTokens: completionTokens,\n        totalTokens: totalTokens,\n      },\n    },\n  },\n];"
      },
